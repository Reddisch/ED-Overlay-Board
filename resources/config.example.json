    { "action": "toggleWindow",      "key": "Ctrl+Alt+Numpad1", "window": "Kneeboard" },
    { "action": "toggleWindow",      "key": "Ctrl+Alt+Numpad2", "window": "EDDiscovery" },
    { "action": "toggleWindow",      "key": "Ctrl+Alt+Numpad3", "window": "Browser" },
    { "action": "nextPage",          "key": "Ctrl+Alt+Numpad6", "window": "Kneeboard" },
    { "action": "prevPage",          "key": "Ctrl+Alt+Numpad4", "window": "Kneeboard" }
  ]
